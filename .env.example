# ===== Server =====
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===== PostgreSQL =====
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/power_mesh?schema=public"

# ===== Prisma =====
BCRYPT_SALT_ROUNDS=10

# ===== JWT =====
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ===== Google OAuth2 (GCP) =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== bKash payment gateway (Tokenized Checkout) =====
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# ===== Redis =====
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# ===== SMTP (Nodemailer) =====
SMTP_USER=your_smtp_user
EMAIL_SENDER=your_email_sender
SMTP_PASSWORD=your_smtp_app_password

# ===== Cloudinary (optional, unused for now) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Demo seed credentials (created automatically in development) =====
SEED_ADMIN_EMAIL=admin@powermesh.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

SEED_PROVIDER_EMAIL=provider@powermesh.com
SEED_PROVIDER_PASSWORD=Provider@123
SEED_PROVIDER_FIRST_NAME=Test
SEED_PROVIDER_LAST_NAME=Provider

SEED_CONSUMER_EMAIL=consumer@powermesh.com
SEED_CONSUMER_PASSWORD=Consumer@123
SEED_CONSUMER_FIRST_NAME=Test
SEED_CONSUMER_LAST_NAME=Consumer
