# =============================================================================
# power-mesh-server — PRODUCTION environment template
# Copy into the host dashboard (Render / Railway / etc.). Do not commit real secrets.
# Pair with power-mesh-client/.env.production.example — FRONTEND_URL and ISR token must match.
# =============================================================================

# ===== Server =====
NODE_ENV=production
PORT=5000
# Must equal NEXT_PUBLIC_APP_URL on the Next app (CORS + bKash browser return).
FRONTEND_URL=https://your-app.example.com

# ===== PostgreSQL =====
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/power_mesh?schema=public&sslmode=require"

# ===== Prisma =====
BCRYPT_SALT_ROUNDS=12

# ===== JWT (use long random secrets; rotate if leaked) =====
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Shared with Next.js ISR_SERVICE_TOKEN. Long random value — not the local dev token.
ISR_SERVICE_TOKEN=replace_with_a_long_random_isr_token

# ===== Google OAuth2 (GCP) — authorized JS origins / redirect URIs must include FRONTEND_URL =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== bKash (sandbox or live) =====
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
# Must be the API public origin callback (not the Next origin).
BKASH_CALLBACK_URL=https://your-api.example.com/api/v1/payments/callback

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_or_test_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Dashboard webhook URL: https://your-api.example.com/api/v1/payments/webhook/stripe
# Subscribe to: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed

# ===== Redis =====
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# ===== SMTP / email =====
SMTP_USER=your_smtp_user
EMAIL_SENDER=your_email_sender
SMTP_PASSWORD=your_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Prefer real delivery in production. Set false once SMTP or Brevo/Resend works.
EMAIL_FAIL_OPEN=false
RESEND_API_KEY=
BREVO_API_KEY=

# ===== Cloudinary (optional profile images) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Seeds =====
# Prefer false in production. Set true only for a controlled demo host that needs
# admin@powermesh.com and the other seeded accounts.
RUN_SEEDS=false
SEED_ADMIN_EMAIL=admin@powermesh.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_PROVIDER_EMAIL=provider@powermesh.com
SEED_PROVIDER_PASSWORD=replace_with_a_strong_provider_password
SEED_PROVIDER_FIRST_NAME=Test
SEED_PROVIDER_LAST_NAME=Provider
SEED_CONSUMER_EMAIL=consumer@powermesh.com
SEED_CONSUMER_PASSWORD=replace_with_a_strong_consumer_password
SEED_CONSUMER_FIRST_NAME=Test
SEED_CONSUMER_LAST_NAME=Consumer
SEED_OPERATOR_EMAIL=operator@powermesh.com
SEED_OPERATOR_PASSWORD=replace_with_a_strong_operator_password
SEED_OPERATOR_FIRST_NAME=Test
SEED_OPERATOR_LAST_NAME=Operator
