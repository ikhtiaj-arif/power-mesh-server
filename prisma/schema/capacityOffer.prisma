model CapacityOffer {
  id                    String       @id @default(uuid())
  providerId            String
  eventId               String
  capacityKw            Int
  pricePerKwh           Decimal      @db.Decimal(10, 4)
  deliveryStart         DateTime
  deliveryEnd           DateTime
  reservedKw            Int          @default(0)
  status                OfferStatus  @default(AVAILABLE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  provider              Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  event                 OutageEvent  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reservations          Reservation[]

  @@unique([providerId, eventId, deliveryStart, deliveryEnd])
  @@index([eventId, status])
  @@index([providerId, status])
  @@index([deliveryStart, deliveryEnd])
  @@map("capacity_offers")
}
