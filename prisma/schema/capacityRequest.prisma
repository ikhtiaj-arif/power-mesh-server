model CapacityRequest {
    id              String        @id @default(uuid())
    consumerId      String
    eventId         String
    requestedKw     Int
    maxPricePerKwh  Decimal       @db.Decimal(10, 4)
    priorityTier    PriorityTier
    status          RequestStatus @default(PENDING)
    rejectionReason String?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    deletedAt       DateTime?

    consumer     Consumer      @relation(fields: [consumerId], references: [id], onDelete: Restrict)
    event        OutageEvent   @relation(fields: [eventId], references: [id], onDelete: Restrict)
    reservations Reservation[]

    // MVP: one active request per consumer per outage event.
    @@unique([consumerId, eventId])
    @@index([eventId, status, priorityTier])
    @@index([consumerId, status])
    @@index([createdAt])
    @@map("capacity_requests")
}
