model Consumer {
  id               String    @id @default(cuid())
  userId           String    @unique
  zoneId           String
  organizationName String
  criticalLoadKw   Int
  address          String
  contactPerson    String
  contactPhone     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  zone             ServiceZone       @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  capacityRequests CapacityRequest[]
  reservations     Reservation[]
  ratings          Rating[]          @relation("consumer_ratings")

  @@unique([userId, zoneId])
  @@index([zoneId])
  @@index([createdAt])
  @@map("consumers")
}
