model OutageEvent {
  id                        String            @id @default(uuid())
  operatorId                String
  scheduledStart            DateTime
  scheduledEnd              DateTime
  status                    OutageEventStatus @default(SCHEDULED)
  totalCapacityKw           Int
  survivalQuotaKw           Int
  allocatedKw               Int               @default(0)
  notes                     String?
  actualStart               DateTime?
  actualEnd                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  operator                  Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  capacityOffers            CapacityOffer[]
  capacityRequests          CapacityRequest[]

  @@index([status, scheduledStart])
  @@index([scheduledStart, scheduledEnd])
  @@index([operatorId])
  @@map("outage_events")
}