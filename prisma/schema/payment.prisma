model Payment {
  id                    String         @id @default(uuid())
  reservationId         String         @unique
  gatewayId             String?        @unique
  gatewayStatus         PaymentStatus  @default(INITIATED)
  amount                Decimal        @db.Decimal(14, 2)
  currency              String         @default("BDT")
  paymentMethod         PaymentMethod  @default(UNKNOWN)
  merchantInvoiceNumber String         @unique
  initiatedAt           DateTime       @default(now())
  completedAt           DateTime?
  idempotencyKey        String         @unique
  webhookStatus         WebhookStatus  @default(PENDING)
  webhookReceivedAt     DateTime?
  webhookProcessedAt    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  reservation           Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  refunds               Refund[]

  @@index([gatewayStatus])
  @@index([webhookStatus])
  @@index([createdAt])
  @@map("payments")
}