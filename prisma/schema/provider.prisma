model Provider {
  id                String       @id @default(cuid())
  userId            String       @unique
  zoneId            String
  companyName       String
  licenseNumber     String       @unique
  resourceType      ResourceType
  capacityKw        Int          @db.Integer
  address           String
  contactPerson     String
  contactPhone      String
  bankAccountNumber String? // Recipient account for refunds
  verified          Boolean      @default(false)
  verifiedAt        DateTime?
  verifiedBy        String? // Operator user_id who verified
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  zone           ServiceZone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  capacityOffers CapacityOffer[]
  reservations   Reservation[]
  incidents      Incident[]
  ratings        Rating[]        @relation("provider_ratings")

  @@unique([userId, zoneId])
  @@index([zoneId])
  @@index([verified])
  @@index([createdAt])
  @@map("providers")
}
