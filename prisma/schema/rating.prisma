model Rating {
  id            String    @id @default(cuid())
  consumerId    String
  providerId    String
  reservationId String?
  rating        Int       @db.SmallInt // 1-5
  reviewText    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  consumer    Consumer     @relation("consumer_ratings", fields: [consumerId], references: [id], onDelete: Restrict)
  provider    Provider     @relation("provider_ratings", fields: [providerId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([createdAt])
  @@map("ratings")
}
