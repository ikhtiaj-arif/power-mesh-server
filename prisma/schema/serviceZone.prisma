model ServiceZone {
  id               String    @id @default(cuid())
  name             String    @unique
  region           String
  gridOperator     String // e.g., "DPDC", "REB", "DHAKA_SOUTH"
  latitude         Float
  longitude        Float
  coverageAreaSqKm Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  providers        Provider[]
  consumers        Consumer[]
  operators        Operator[]
  outageEvents     OutageEvent[]
  capacityOffers   CapacityOffer[]
  capacityRequests CapacityRequest[]

  @@index([gridOperator])
  @@map("service_zones")
}
